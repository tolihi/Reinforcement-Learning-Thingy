<mujoco model="ur5e ppo obstacle scene">
  <!-- 基于 menagerie 原版 scene.xml 修改：
       1. 保留地面/光照/天空盒
       2. 新增 obstacle：红色球形障碍物（真实碰撞体，位置/半径每回合由环境随机化）
       3. 新增 target：绿色半透明目标球（仅可视化，不参与碰撞）
  -->
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 障碍物：contype/conaffinity=1 与机械臂碰撞 geom 产生接触；
         运行时通过 model.geom_pos / model.geom_size 随机化位置和半径 -->
    <geom name="obstacle" type="sphere" size="0.06" pos="0.4 0 0.4"
          rgba="0.9 0.25 0.2 1" contype="1" conaffinity="1"/>

    <!-- 目标点：contype=0 不碰撞，仅用于可视化 EE 要到达的位置 -->
    <geom name="target" type="sphere" size="0.04" pos="0.45 0.2 0.35"
          rgba="0.2 0.85 0.2 0.35" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
